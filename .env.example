# ============================================
# APARTMENT 803 — Environment Variables
# Copy this file to .env.local and fill in values
# In Replit: add these to the Secrets tab (lock icon)
# ============================================

# Retell AI — get from retellai.com/dashboard → API Keys
RETELL_API_KEY=your_retell_api_key_here

# Supabase — get from supabase.com → your project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# App config
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Apartment 803

# Webhook secret — any random string, use to verify Retell webhooks
RETELL_WEBHOOK_SECRET=your_random_secret_string_here
